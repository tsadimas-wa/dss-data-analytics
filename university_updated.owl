<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://www.example.org/university"
         xmlns="http://www.example.org/university#">

<owl:Ontology rdf:about="http://www.example.org/university"/>

<owl:ObjectProperty rdf:about="#hasPrerequisite">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <rdfs:domain rdf:resource="#Course"/>
  <rdfs:range rdf:resource="#Course"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#offeredBy">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Course"/>
  <rdfs:range rdf:resource="#Department"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#taughtBy">
  <rdfs:domain rdf:resource="#Course"/>
  <rdfs:range rdf:resource="#Professor"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#courseCode">
  <rdfs:domain rdf:resource="#Course"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#credits">
  <rdfs:domain rdf:resource="#Course"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#departmentName">
  <rdfs:domain rdf:resource="#Department"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#semester">
  <rdfs:domain rdf:resource="#Course"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="#AdvancedCourse">
  <rdfs:subClassOf rdf:resource="#Course"/>
  <owl:disjointWith rdf:resource="#IntroductoryCourse"/>
</owl:Class>

<owl:Class rdf:about="#Course"/>

<owl:Class rdf:about="#Department"/>

<owl:Class rdf:about="#IntroductoryCourse">
  <rdfs:subClassOf rdf:resource="#Course"/>
</owl:Class>

<owl:Class rdf:about="#Professor"/>

<owl:NamedIndividual rdf:about="#Algorithms">
  <rdf:type rdf:resource="#AdvancedCourse"/>
  <hasPrerequisite rdf:resource="#DataStructures"/>
  <hasPrerequisite rdf:resource="#Programming1"/>
  <courseCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CS301</courseCode>
  <credits rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</credits>
  <semester rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</semester>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#DataStructures">
  <rdf:type rdf:resource="#AdvancedCourse"/>
  <hasPrerequisite rdf:resource="#Programming1"/>
  <offeredBy rdf:resource="#Informatics"/>
  <taughtBy rdf:resource="#Prof_Tsadimas"/>
  <courseCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CS201</courseCode>
  <credits rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</credits>
  <semester rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</semester>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Informatics">
  <rdf:type rdf:resource="#Department"/>
  <departmentName rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></departmentName>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#MachineLearning">
  <rdf:type rdf:resource="#AdvancedCourse"/>
  <hasPrerequisite rdf:resource="#DataStructures"/>
  <hasPrerequisite rdf:resource="#Math1"/>
  <hasPrerequisite rdf:resource="#Programming1"/>
  <courseCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CS401</courseCode>
  <credits rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</credits>
  <semester rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</semester>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Math1">
  <rdf:type rdf:resource="#IntroductoryCourse"/>
  <courseCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MAT101</courseCode>
  <credits rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">5.0</credits>
  <semester rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</semester>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Prof_Tsadimas">
  <rdf:type rdf:resource="#Professor"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Programming1">
  <rdf:type rdf:resource="#IntroductoryCourse"/>
  <courseCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CS101</courseCode>
  <credits rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</credits>
  <semester rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</semester>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#DeepLearning">
  <rdf:type rdf:resource="#AdvancedCourse"/>
  <hasPrerequisite rdf:resource="#MachineLearning"/>
  <courseCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CS501</courseCode>
  <credits rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</credits>
  <semester rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</semester>
</owl:NamedIndividual>


</rdf:RDF>
