flowchart TB
    subgraph Inputs["Sprint Δεδομένα"]
        direction LR
        A["🗓 Διαθέσιμος Χρόνος\nSprint = 2 εβδομάδες\n= 80 ώρες (1 dev)"]
        B["📋 Ζήτηση Πελάτη\n8 features\nανά Sprint"]
    end

    T["⏱ <b>Takt Time</b>\n= 80 ÷ 8\n= <b>10 ώρες / feature</b>\n(ο «μετρονόμος» της ομάδας)"]

    subgraph Scenarios["Σύγκριση Cycle Time vs Takt Time"]
        direction LR
        S1["⚠️ <b>Cycle > Takt</b>\n15h &gt; 10h\nBacklog αυξάνεται\nΟ developer «χρωστάει»"]
        S2["✅ <b>Cycle = Takt</b>\n10h = 10h\nΤέλεια ισορροπία\nΑκριβής ικανοποίηση"]
        S3["💡 <b>Cycle &lt; Takt</b>\n6h &lt; 10h\nΕλεύθερη χωρητικότητα\nΔυνατότητα βελτίωσης"]
    end

    A --> T
    B --> T
    T --> S1
    T --> S2
    T --> S3

